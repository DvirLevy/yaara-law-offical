# Base URL for site images (S3 bucket or CloudFront distribution).
# Leave unset in local dev to fall back to the images in public/assets.
VITE_S3_BASE_URL=https://your-bucket.s3.amazonaws.com

# Base URL for section copy (JSON per section: hero.json, about.json, ...).
# When set, content is fetched at runtime from ${VITE_CONTENT_BASE_URL}/{section}.json
# with the bundled content/*.ts modules used as an in-memory fallback if the
# fetch fails. Leave unset (e.g. local dev) to always use the bundled content
# with no network request.
VITE_CONTENT_BASE_URL=https://cdn.yl-law.net/content
